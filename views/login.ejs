<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>管理员登录 · 时序档案馆</title>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/upload.css">
</head>
<body>
<div class="board ua-bg">
  <div class="ua-login-wrap">
    <section class="panel">
      <div class="brand" style="margin-bottom:var(--s5)">
        <div>
          <span class="zh">时序档案馆</span>
          <span class="en">TIME ARCHIVE</span>
        </div>
      </div>
      <div class="sect-head"><i class="bar"></i><h3 class="ua-h3">管理员登录</h3></div>

      <% if (error) { %>
      <div class="errrow">
        <span class="ec"><%= error.code %></span>
        <p><%= error.message %><span>账号或密码不匹配时统一返回 40102，不区分具体原因</span></p>
      </div>
      <% } %>

      <form method="post" action="/admin/login" class="ua-fields">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="username">账号</label>
          <input class="input" id="username" name="username" type="text" autocomplete="username" required>
        </div>
        <div class="field">
          <label for="password">密码</label>
          <input class="input" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn gold lg" type="submit" style="justify-content:center">登录后台</button>
      </form>
      <p class="ua-tip">演示账号：admin / admin12345（种子数据，仅本地演示用）</p>
    </section>
  </div>
</div>
</body>
</html>
